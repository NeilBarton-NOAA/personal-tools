#!/bin/sh
set -u
# gets a file quickly to HPSS to use htar, command is
#   htar -xvf ${ARCHIVE_HOME}/test.tar ${FILES}
FILE=${1:-$PWD}
YEAR=${2:-1}

HSI_DIR=/NCEPDEV/emc-marine/${YEAR}year/Neil.Barton
echo "GETTING: ${HSI_DIR}/${FILE}"
hsi -q get ${FILE} : ${HSI_DIR}/${FILE} 2>/dev/null
(( $? != 0 )) && echo "TRANSFER FAILED: ${HSI_DIR}/${FILE}"
