#!/bin/sh
set -u
ARGS=${@}
LAST_ARG=${@: -1}
if (( ${#} == 0 )); then
    echo 'ERROR: files/arguments most be supplied'
    exit 1
fi

if [[ -f ${LAST_ARG} ]]; then
    REMOTE_FOLDER=/home/nbarton
    FILES=${@}
else
    REMOTE_FOLDER=${LAST_ARG}
    FILES=${@:1:$(($#-1))}
fi
 
scp ${FILES} nbarton@orion-dtn.hpc.msstate.edu:${REMOTE_FOLDER} 
