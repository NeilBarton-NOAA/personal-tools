#!/bin/sh
set -u
ARGS=${@}
LAST_ARG=${@: -1}
if (( ${#} == 0 )); then
    echo 'ERROR: files/arguments most be supplied'
    exit 1
fi

if [[ -f ${LAST_ARG} ]]; then
    REMOTE_FOLDER=/work/noaa/marine/nbarton
    FILES=${@}
else
    REMOTE_FOLDER=${LAST_ARG}
    FILES=${@:1:$(($#-1))}
fi
echo "hercules:${REMOTE_FOLDER}"
#scp ${FILES} nbarton@hercules-dtn.hpc.msstate.edu:${REMOTE_FOLDER} 
scp -o LogLevel=QUIET ${FILES} nbarton@hercules-dtn.hpc.msstate.edu:${REMOTE_FOLDER} 
