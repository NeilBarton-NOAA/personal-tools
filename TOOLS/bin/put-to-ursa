#!/bin/sh
set -u
ARGS=${@}
LAST_ARG=${@: -1}
if (( ${#} == 0 )); then
    echo 'ERROR: files/arguments most be supplied'
    exit 1
fi

if [[ -f ${LAST_ARG} ]]; then
    REMOTE_FOLDER=/scratch4/NCEPDEV/stmp/Neil.Barton
    FILES=${@}
else
    REMOTE_FOLDER=${LAST_ARG}
    FILES=${@:1:$(($#-1))}
fi

scp ${FILES} Neil.Barton@dtn-ursa.fairmont.rdhpcs.noaa.gov:${REMOTE_FOLDER}
