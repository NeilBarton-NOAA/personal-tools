#!/bin/sh
set -u

db=F
xml=F
while getopts ":d:w:r:" opt; do
    case $opt in
        d ) db=$OPTARG;;
        w ) xml=$OPTARG;;
    esac
done


printstats () {
    db=$1
    xml=$2
    echo $(basename ${db})
    echo "db=$db"
    echo "xml=$xml"
    rocotorun -d ${db} -w ${xml} 
    rocotostat -d ${db} -w ${xml} >& temp.out
    head -n 1 temp.out 
    grep 'SUCCEEDED' temp.out | head -n 1
    grep -v '=' temp.out | grep -v 'SUCCEEDED' | grep -v 'CYCLE' | awk '$6 != "-"' 
    grep 'SUCCEEDED' temp.out | tail -n 1
    rm temp.out
    echo ""
    echo ""
}

if [[ $db == F ]] || [[ $xml == F ]]; then
    dbs=( $(crontab -l | grep rocotorun | awk '{print $8}') )
    xmls=( $(crontab -l | grep rocotorun | awk '{print $10}') )
    N=$(( ${#dbs[@]} - 1 ))
    for i in $(seq 0 $N); do
        printstats ${dbs[$i]} ${xmls[$i]}
    done
else
    printstats ${db} ${xml}
fi
