#!/bin/sh
set -u

db=F
xml=F
while getopts ":d:w:r:" opt; do
    case $opt in
        d ) db=$OPTARG;;
        w ) xml=$OPTARG;;
    esac
done
machine=$( uname -n )

printstats () {
    db=$1
    xml=$2
    echo $(basename ${db})
    echo "db=$db"
    echo "xml=$xml"
    temp_file=~/temp.out
    rocotorun -d ${db} -w ${xml} 
    rocotostat -d ${db} -w ${xml} >& $temp_file
    head -n 1 $temp_file
    grep 'SUCCEEDED' $temp_file | head -n 1
    grep -v '=' $temp_file | grep -v 'SUCCEEDED' | grep -v 'CYCLE' | awk '$6 != "-"' 
    grep 'SUCCEEDED' $temp_file | tail -n 1
    rm $temp_file
    echo ""
    echo ""
}

if [[ $db == F ]] || [[ $xml == F ]]; then
    if [[ ${machine} == gaea* ]]; then
        scrons=$(scrontab -l | grep scron | grep EXPDIR | awk '{print $6}') 
        dbs=()
        xmls=()
        for scron in ${scrons}; do
            dbs+=( ${scron%%scron.sh*}db )
            xmls+=( ${scron%%scron.sh*}xml )
        done
    else
        dbs=( $(crontab -l | grep rocotorun | awk '{print $8}') )
        xmls=( $(crontab -l | grep rocotorun | awk '{print $10}') )
    fi
    N=$(( ${#dbs[@]} - 1 ))
    for i in $(seq 0 $N); do
        printstats ${dbs[$i]} ${xmls[$i]}
    done
else
    printstats ${db} ${xml}
fi
