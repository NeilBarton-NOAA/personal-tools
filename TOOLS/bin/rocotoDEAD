#!/bin/sh
set -u
db=F
xml=F
run=F
set_complete=F
while getopts "d:w:rc" opt; do
    case $opt in
        d ) db=$OPTARG;;
        w ) xml=$OPTARG;;
        r ) run=T;;
        c ) set_complete=T;;
    esac
done
machine=$( uname -n )

printdeadtasks () {
    db=$1
    xml=$2
    echo $(basename ${db})
    echo "db=${db}"
    echo "xml=${xml}"
    rocotorun -d ${db} -w ${xml} 
    if (( $(rocotostat -d ${db} -w ${xml} | grep -E 'DEAD|FAILED' | wc -l) == 0 )); then
        echo ' no dead or failed tasks'
    else
        rocotostat -d ${db} -w ${xml} | grep -E 'DEAD|FAILED' 
    fi
    echo " "
}

rundeadtasks () {
    db=$1
    xml=$2
    echo 'rerunning tasks'
    ts=( $(rocotostat -d ${db} -w ${xml} | grep -E 'DEAD|FAILED' | awk '{print $2}') )
    cs=( $(rocotostat -d ${db} -w ${xml} | grep -E 'DEAD|FAILED' | awk '{print $1}') )
    ND=$(( ${#ts[@]} - 1 ))
    for j in $(seq 0 $ND); do
        rocotoboot -d ${db} -w ${xml} -c ${cs[$j]} -t ${ts[$j]}
    done
}

runsettaskscomplete () {
    db=$1
    xml=$2
    echo 'setting tasks to complete'
    ts=( $(rocotostat -d ${db} -w ${xml} | grep -E 'DEAD|FAILED' | awk '{print $2}') )
    cs=( $(rocotostat -d ${db} -w ${xml} | grep -E 'DEAD|FAILED' | awk '{print $1}') )
    ND=$(( ${#ts[@]} - 1 ))
    for j in $(seq 0 $ND); do
        rocotocomplete -d ${db} -w ${xml} -c ${cs[$j]} -t ${ts[$j]}
    done
}

if [[ $db == F ]] || [[ $xml == F ]]; then
    if [[ ${machine} == gaea* ]]; then
        scrons=$(scrontab -l | grep scron | awk '{print $6}') 
        dbs=()
        xmls=()
        for scron in ${scrons}; do
            dbs+=( ${scron%%scron.sh*}db )
            xmls+=( ${scron%%scron.sh*}xml )
        done
    else
        dbs=( $(crontab -l | grep rocotorun | awk '{print $8}') )
        xmls=( $(crontab -l | grep rocotorun | awk '{print $10}') )
    fi
    N=$(( ${#dbs[@]} - 1 ))
    for i in $(seq 0 $N); do
        printdeadtasks ${dbs[$i]} ${xmls[$i]} 
        if [[ $run == T ]]; then
            rundeadtasks ${dbs[$i]} ${xmls[$i]} 
        elif [[ $set_complete == T ]]; then
            runsettaskscomplete ${dbs[$i]} ${xmls[$i]}
        fi
    done
else
    printdeadtasks ${db} ${xml} 
    if [[ $run == T ]]; then
        rundeadtasks ${db} ${xml} 
    elif [[ $set_complete == T ]]; then
        runsettaskscomplete ${db} ${xml}
    fi
fi
